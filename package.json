{
  "name": "claw-agent-framework",
  "version": "1.0.0",
  "description": "Telegram-native multi-agent AI assistant framework: agent loop, crew orchestration, scheduler, memory, and pluggable integrations.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "schedule": "tsx src/schedule-cli.ts",
    "crew": "tsx src/crew-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.85",
    "better-sqlite3": "^11.7.0",
    "cron-parser": "^5.0.0",
    "grammy": "^1.35.0",
    "openai": "^4.85.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
